# App
APP_NAME=Leave Requests Demo
PORT=5001

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DB_SSL=true

# Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=demo-admin-password
JWT_SECRET=demo-jwt-secret-change-me

# Email
MAIL_FROM="Leave Requests Demo <noreply@example.com>"
MAIL_TO=team@example.com

# Optional external mail API
MAIL_API_URL=
MAIL_API_KEY=

# Optional SMTP fallback
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=demo-user
SMTP_PASS=demo-password
